<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="An interactive practice journal for Grade 11 General English — grammar, vocabulary, reading, writing, listening and speaking. Designed and Developed by Jawahar." />
<meta name="theme-color" content="#F4EFE5" />
<meta name="color-scheme" content="light" />

<meta property="og:type" content="website" />
<meta property="og:title" content="Grade 11 General / English · Term 3 · 2026" />
<meta property="og:description" content="An interactive practice journal for Grade 11 General English — designed and created by Jawahar." />
<meta property="og:locale" content="en_AE" />
<title>Grade 11 General · English · Term 3 · 2026</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap" rel="stylesheet">

<style>
:root {
  --ivory:       #F4EFE5;
  --ivory-deep:  #EAE0CB;
  --sand:        #EEE3CD;
  --sand-deep:   #DFD1B3;
  --sky:         #DDE9EC;
  --card:        #FBF7EE;
  --ink:         #14282E;
  --ink-2:       #2D4A52;
  --mute:        #5E747A;     
  --rule:        #D4C9B0;
  --rule-2:      #B7A685;
  --teal:        #1F5560;     
  --teal-deep:   #123842;
  --teal-soft:   #8FB3B9;
  --gold:        #B8932F;     
  --gold-deep:   #876A1E;
  --mint:        #C4DDD0;     
  --ok:          #4F8C66;
  --no:          #B14545;
  --display:     "DM Serif Display", "Georgia", serif;
  --body:        "DM Sans", sans-serif;
  --shadow-1:    0 8px 24px -10px rgba(18, 56, 66, 0.14), 0 2px 6px -2px rgba(18, 56, 66, 0.07);
}
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0; font-family: var(--body); font-size: 17px; line-height: 1.6; color: var(--ink); background: var(--ivory); min-height: 100vh; position: relative;
}
body::before {
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 0;
  background: radial-gradient(ellipse 80% 50% at 80% 0%, rgba(221, 233, 236, 0.6), transparent 70%), radial-gradient(ellipse 60% 40% at 0% 100%, rgba(31, 85, 96, 0.07), transparent 60%);
}
h1, h2 { font-family: var(--display); font-weight: 500; margin: 0; color: var(--ink); }
h1 { font-size: clamp(2.6rem, 6.5vw, 5.6rem); line-height: 1; letter-spacing: -0.02em; }
h2 { font-size: clamp(1.7rem, 3.2vw, 2.4rem); line-height: 1.15; }
h3 { font-size: 1.3rem; font-weight: 600; margin: 0; }
.topbar { position: sticky; top: 0; z-index: 30; background: rgba(244, 239, 229, 0.92); backdrop-filter: blur(14px); border-bottom: 1px solid var(--rule); padding: 14px 40px; display: flex; justify-content: space-between; align-items: center; }
.brand { font-family: var(--display); font-style: italic; font-size: 1.4rem; color: var(--ink); }
.brand span { color: var(--teal); }
.nav-links a { margin-left: 15px; color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.9rem; }
.nav-links a:hover { color: var(--teal); }
.content-container { max-width: var(--content-max); margin: 40px auto; padding: 0 20px; position: relative; z-index: 10; }
.jawahar-panel { background: #FBF7EE; border: 2px dashed var(--rule-2); border-radius: 12px; padding: 25px; margin-bottom: 40px; box-shadow: var(--shadow-1); }
.jawahar-title { font-family: var(--display); font-style: italic; color: var(--ink); font-size: 1.6rem; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
.jawahar-title span { font-size: 0.8rem; background: var(--teal); color: white; padding: 3px 8px; border-radius: 4px; font-family: var(--body); font-style: normal; }
.jawahar-select { padding: 10px; border-radius: 6px; border: 1px solid var(--rule); font-family: var(--body); width: 100%; margin-bottom: 15px; }
.jawahar-textarea { width: 100%; height: 120px; padding: 12px; border-radius: 6px; border: 1px solid var(--rule); font-family: monospace; font-size: 0.9rem; margin-bottom: 15px; background: white; }
.jawahar-btn { background: var(--teal); color: white; border: none; padding: 12px 24px; font-weight: bold; border-radius: 6px; cursor: pointer; font-family: var(--body); transition: background 0.2s; }
.jawahar-btn:hover { background: var(--teal-deep); }
.app-section { background: white; border: 1px solid var(--rule); border-radius: 16px; padding: 30px; margin-bottom: 30px; box-shadow: var(--shadow-1); }
.section-header { font-family: var(--display); font-size: 2rem; color: var(--ink); border-bottom: 2px solid var(--ivory-deep); padding-bottom: 10px; margin-bottom: 20px; }
.injected-activity { background: var(--card); border-left: 4px solid var(--teal); padding: 15px; margin-top: 15px; border-radius: 0 8px 8px 0; font-style: italic; position: relative; }
.delete-injected { position: absolute; top: 10px; right: 10px; background: transparent; border: none; color: var(--no); font-weight: bold; cursor: pointer; }
.quiz-option { display: block; background: var(--ivory); border: 1px solid var(--rule); padding: 12px; margin-bottom: 8px; border-radius: 8px; cursor: pointer; transition: background 0.2s; }
.quiz-option:hover { background: var(--sky); }
.feedback-box { margin-top: 10px; font-weight: bold; font-size: 0.95rem; }
.feedback-box.correct { color: var(--ok); }
.feedback-box.incorrect { color: var(--no); }
footer { text-align: center; padding: 40px; border-top: 1px solid var(--rule); color: var(--mute); font-size: 0.85rem; letter-spacing: 0.05em; }
</style>
</head>
<body>

<div class="topbar">
  <div class="brand">Grade 11 / <span>General English</span></div>
  <div class="nav-links">
    <a href="#grammar">Grammar</a>
    <a href="#vocab">Vocabulary</a>
    <a href="#reading">Reading</a>
    <a href="#writing">Writing</a>
  </div>
</div>

<div class="content-container">
  
  <div class="jawahar-panel">
    <div class="jawahar-title">Add Custom Content & Dynamic Activities <span>Creator Dashboard</span></div>
    <p style="font-size:0.85rem; color: var(--mute); margin:-5px 0 15px 0;">Select a specific active section and write or paste raw HTML code / task notes to instantly deploy items directly onto the page layout live.</p>
    <select id="sectionSelector" class="jawahar-select">
      <option value="grammar">Grammar Practice Module</option>
      <option value="vocab">Vocabulary Enrichment</option>
      <option value="reading">Reading Comprehension Segment</option>
      <option value="writing">General Writing Workbox</option>
    </select>
    <textarea id="customContentInput" class="jawahar-textarea" placeholder="Enter instructions, embedded frame elements, or HTML code blocks here..."></textarea>
    <button class="jawahar-btn" onclick="injectJawaharContent()">Deploy Element Directly</button>
  </div>

  <div id="grammar" class="app-section">
    <div class="section-header">01. Grammar Practice</div>
    <p>Practice structural rules, verb forms, and modal patterns tailored for Grade 11 Term 3 tracks.</p>
    
    <div style="margin-top:20px;">
      <p><b>Question 1:</b> Select the correct verb form: If we _____ early, we would have found optimal seating options.</p>
      <div class="quiz-option" onclick="checkGenQuiz(this, true, 'Excellent! &ldquo;Had arrived&rdquo; sets up the conditional frame perfectly.')">A) had arrived</div>
      <div class="quiz-option" onclick="checkGenQuiz(this, false, 'Try again. Consider the conditional formatting requirements.')">B) arrive</div>
      <div class="feedback-box"></div>
    </div>
    <div id="inject-grammar"></div>
  </div>

  <div id="vocab" class="app-section">
    <div class="section-header">02. Vocabulary Base</div>
    <p>Enhance core terms relating to digital literacy, communication arts, and educational integrity.</p>
    
    <div style="margin-top:20px;">
      <p><b>Question 1:</b> A physical movement that carries a distinct, communicative meaning is termed a _____.</p>
      <div class="quiz-option" onclick="checkGenQuiz(this, true, 'Correct! A gesture is used to express ideas physically.')">A) gesture</div>
      <div class="quiz-option" onclick="checkGenQuiz(this, false, 'Try again. A merchant deals with commerce and trading assets.')">B) merchant</div>
      <div class="feedback-box"></div>
    </div>
    <div id="inject-vocab"></div>
  </div>

  <div id="reading" class="app-section">
    <div class="section-header">03. Reading Comprehension</div>
    <p>Read simplified Term 3 texts to evaluate central summaries, structural features, and contexts.</p>
    <div style="background: var(--card); padding: 15px; border-radius: 8px; font-style: italic; margin-bottom: 15px;">
      "Digital citizenship groups advise that structured safety rules along with comprehensive platform support reduce online cyberbullying occurrences significantly."
    </div>
    <div>
      <p><b>Question 1:</b> What is the core idea of the passage?</p>
      <div class="quiz-option" onclick="checkGenQuiz(this, true, 'Correct! Awareness and clear support combine to solve online safety issues.')">A) Cyberbullying needs awareness, support, and clear action.</div>
      <div class="quiz-option" onclick="checkGenQuiz(this, false, 'Incorrect. Privacy configurations cannot substitute for proper behavior.')">B) Privacy settings automatically resolve all online behavior issues.</div>
      <div class="feedback-box"></div>
    </div>
    <div id="inject-reading"></div>
  </div>

  <div id="writing" class="app-section">
    <div class="section-header">04. Guided Writing Hub</div>
    <p>Construct sentences, focus paragraphs, and comparison lines for Term 3 targets.</p>
    <textarea style="width:100%; height:120px; border-radius:8px; border:1px solid var(--rule); padding:10px;" placeholder="Write response here..."></textarea>
    <div id="inject-writing"></div>
  </div>

</div>

<footer>
  <p>&copy; 2026 Jawahar. Designed & Created by Jawahar. All Rights Reserved.</p>
</footer>

<script>
function checkGenQuiz(element, isCorrect, feedbackText) {
  const parent = element.parentNode;
  const feedback = parent.querySelector('.feedback-box');
  feedback.textContent = feedbackText;
  feedback.className = 'feedback-box ' + (isCorrect ? 'correct' : 'incorrect');
}

function injectJawaharContent() {
  const targetSection = document.getElementById('sectionSelector').value;
  const rawText = document.getElementById('customContentInput').value.trim();
  if(!rawText) { alert('Please insert your text or HTML layout first.'); return; }
  
  const internalKey = 'jawahar_gen_' + targetSection + '_' + Date.now();
  const packageData = { id: internalKey, section: targetSection, data: rawText };
  
  let currentItems = JSON.parse(localStorage.getItem('jawahar_gen_content') || '[]');
  currentItems.push(packageData);
  localStorage.setItem('jawahar_gen_content', JSON.stringify(currentItems));
  
  buildInjectedNode(packageData);
  document.getElementById('customContentInput').value = '';
}

function buildInjectedNode(item) {
  const container = document.getElementById('inject-' + item.section);
  if(!container) return;
  
  const wrapper = document.createElement('div');
  wrapper.className = 'injected-activity';
  wrapper.id = item.id;
  wrapper.innerHTML = item.data + `<button class="delete-injected" onclick="removeJawaharNode('${item.id}')">&times;</button>`;
  container.appendChild(wrapper);
}

function removeJawaharNode(id) {
  if(!confirm('Are you sure you want to remove this item?')) return;
  document.getElementById(id).remove();
  let currentItems = JSON.parse(localStorage.getItem('jawahar_gen_content') || '[]');
  currentItems = currentItems.filter(i => i.id !== id);
  localStorage.setItem('jawahar_gen_content', JSON.stringify(currentItems));
}

window.addEventListener('DOMContentLoaded', () => {
  const stored = JSON.parse(localStorage.getItem('jawahar_gen_content') || '[]');
  stored.forEach(buildInjectedNode);
});
</script>
</body>
</html>
